name: Автоматическое сканирование безопасности (OWASP ZAP)

# Запускается вручную (кнопка Run workflow) или при пуше в main.
on:
  workflow_dispatch:
  push:
    branches: [ main ]

permissions:
  contents: read
  issues: write   # позволяет ZAP открыть issue со списком найденных уязвимостей

jobs:
  zap_baseline:
    name: ZAP Baseline Scan против Juice Shop
    runs-on: ubuntu-latest

    steps:
      - name: Получить код репозитория
        uses: actions/checkout@v4

      - name: Запустить мишень (Juice Shop)
        run: |
          docker run -d --rm -p 3000:3000 --name juice-shop bkimminich/juice-shop

      - name: Дождаться запуска Juice Shop
        run: |
          for i in $(seq 1 40); do
            if curl -sf http://localhost:3000 >/dev/null; then
              echo "✅ Juice Shop поднялся"; exit 0
            fi
            echo "ожидание... ($i)"; sleep 5
          done
          echo "❌ Juice Shop не поднялся"; exit 1

      - name: OWASP ZAP Baseline Scan
        uses: zaproxy/action-baseline@v0.14.0
        with:
          # 172.17.0.1 — адрес хоста из контейнера ZAP (docker bridge gateway).
          # Juice Shop опубликован на хосте через -p 3000:3000.
          target: 'http://172.17.0.1:3000'
          rules_file_name: '.zap/rules.tsv'
          cmd_options: '-a'
          artifact_name: 'zap-baseline-report'
          allow_issue_writing: true
          fail_action: false
